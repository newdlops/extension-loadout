{
  "name": "extension-loadout",
  "displayName": "Extension Loadout",
  "description": "Equip each workspace with only the extensions it needs: turn extensions on or off per folder from one panel, saved in .vscode/extension-loadout.json.",
  "version": "0.4.0",
  "publisher": "newdlops",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2a5c",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newdlops/extension-loadout.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "extensions",
    "workspace",
    "enable",
    "disable",
    "profile",
    "memory"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "workspaceContains:.vscode/extension-loadout.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionLoadout",
          "title": "Extension Loadout",
          "icon": "media/loadout.svg"
        }
      ]
    },
    "views": {
      "extensionLoadout": [
        {
          "id": "extensionLoadout.extensions",
          "name": "This Folder"
        }
      ],
      "explorer": [
        {
          "id": "extensionLoadout.explorer",
          "name": "Extension Loadout",
          "icon": "media/loadout.svg",
          "contextualTitle": "Extension Loadout",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "extensionLoadout.extensions",
        "contents": "Open a folder to choose which extensions run in it.",
        "when": "workbenchState == empty"
      },
      {
        "view": "extensionLoadout.explorer",
        "contents": "Open a folder to choose which extensions run in it.",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "extensionLoadout.applyAndRestart",
        "title": "Apply Loadout and Restart VS Code",
        "category": "Extension Loadout",
        "icon": "$(debug-restart)"
      },
      {
        "command": "extensionLoadout.disableSelected",
        "title": "Turn Off Selected",
        "category": "Extension Loadout",
        "icon": "$(circle-slash)"
      },
      {
        "command": "extensionLoadout.clearSelection",
        "title": "Clear Selection",
        "category": "Extension Loadout",
        "icon": "$(clear-all)"
      },
      {
        "command": "extensionLoadout.suggest",
        "title": "Find Extensions This Folder Doesn't Need",
        "category": "Extension Loadout",
        "icon": "$(lightbulb)"
      },
      {
        "command": "extensionLoadout.disableSuggested",
        "title": "Turn Off All Suggested",
        "category": "Extension Loadout",
        "icon": "$(circle-slash)"
      },
      {
        "command": "extensionLoadout.pick",
        "title": "Choose Extensions for This Workspace...",
        "category": "Extension Loadout",
        "icon": "$(checklist)"
      },
      {
        "command": "extensionLoadout.enableHere",
        "title": "Turn On in This Workspace",
        "category": "Extension Loadout",
        "icon": "$(pass-filled)"
      },
      {
        "command": "extensionLoadout.disableHere",
        "title": "Turn Off in This Workspace",
        "category": "Extension Loadout",
        "icon": "$(circle-slash)"
      },
      {
        "command": "extensionLoadout.followGlobal",
        "title": "Follow Global Setting",
        "category": "Extension Loadout",
        "icon": "$(discard)"
      },
      {
        "command": "extensionLoadout.openConfig",
        "title": "Open Loadout File",
        "category": "Extension Loadout",
        "icon": "$(go-to-file)"
      },
      {
        "command": "extensionLoadout.refresh",
        "title": "Refresh",
        "category": "Extension Loadout",
        "icon": "$(refresh)"
      },
      {
        "command": "extensionLoadout.applyMenu",
        "title": "Apply Loadout…",
        "category": "Extension Loadout",
        "icon": "$(debug-restart)"
      },
      {
        "command": "extensionLoadout.applyOnQuit",
        "title": "Apply Loadout When VS Code Quits",
        "category": "Extension Loadout",
        "icon": "$(clock)"
      },
      {
        "command": "extensionLoadout.cancelApplyOnQuit",
        "title": "Cancel Apply on Quit",
        "category": "Extension Loadout",
        "icon": "$(close)"
      },
      {
        "command": "extensionLoadout.applyToOtherFolders",
        "title": "Apply Loadout to Other Folders…",
        "category": "Extension Loadout",
        "icon": "$(folder-library)"
      },
      {
        "command": "extensionLoadout.undo",
        "title": "Undo Last Apply",
        "category": "Extension Loadout",
        "icon": "$(discard)"
      },
      {
        "command": "extensionLoadout.resetToGlobal",
        "title": "Reset Folder to Global Settings",
        "category": "Extension Loadout",
        "icon": "$(clear-all)"
      },
      {
        "command": "extensionLoadout.showMemory",
        "title": "Show Extension Memory",
        "category": "Extension Loadout",
        "icon": "$(pulse)"
      },
      {
        "command": "extensionLoadout.measureMemory",
        "title": "Measure Memory Again",
        "category": "Extension Loadout",
        "icon": "$(sync)"
      },
      {
        "command": "extensionLoadout.restartExtensionHost",
        "title": "Restart Extension Host (Free Extension Memory)",
        "category": "Extension Loadout",
        "icon": "$(debug-restart-frame)"
      },
      {
        "command": "extensionLoadout.disableLearned",
        "title": "Turn Off All Usually-Off Extensions",
        "category": "Extension Loadout",
        "icon": "$(circle-slash)"
      },
      {
        "command": "extensionLoadout.installRecommended",
        "title": "Install Recommended Extension",
        "category": "Extension Loadout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "extensionLoadout.savePreset",
        "title": "Save Loadout as Preset…",
        "category": "Extension Loadout",
        "icon": "$(save)"
      },
      {
        "command": "extensionLoadout.applyPreset",
        "title": "Apply Preset to This Folder…",
        "category": "Extension Loadout",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "extensionLoadout.deletePreset",
        "title": "Delete Preset…",
        "category": "Extension Loadout",
        "icon": "$(trash)"
      },
      {
        "command": "extensionLoadout.viewOptions",
        "title": "Filter and Sort…",
        "category": "Extension Loadout",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extensionLoadout.disableSelected",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && extensionLoadout.hasSelection",
          "group": "navigation@1"
        },
        {
          "command": "extensionLoadout.clearSelection",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && extensionLoadout.hasSelection",
          "group": "navigation@2"
        },
        {
          "command": "extensionLoadout.applyMenu",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && (extensionLoadout.pending || extensionLoadout.applyOnQuit)",
          "group": "navigation@3"
        },
        {
          "command": "extensionLoadout.suggest",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "navigation@4"
        },
        {
          "command": "extensionLoadout.viewOptions",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "navigation@5"
        },
        {
          "command": "extensionLoadout.pick",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "navigation@6"
        },
        {
          "command": "extensionLoadout.openConfig",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "navigation@7"
        },
        {
          "command": "extensionLoadout.refresh",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "navigation@8"
        },
        {
          "command": "extensionLoadout.applyOnQuit",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && extensionLoadout.pending && !extensionLoadout.applyOnQuit",
          "group": "1_apply@1"
        },
        {
          "command": "extensionLoadout.cancelApplyOnQuit",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && extensionLoadout.applyOnQuit",
          "group": "1_apply@2"
        },
        {
          "command": "extensionLoadout.applyToOtherFolders",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "1_apply@3"
        },
        {
          "command": "extensionLoadout.undo",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && extensionLoadout.canUndo",
          "group": "2_history@1"
        },
        {
          "command": "extensionLoadout.resetToGlobal",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "2_history@2"
        },
        {
          "command": "extensionLoadout.restartExtensionHost",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "3_memory@1"
        },
        {
          "command": "extensionLoadout.savePreset",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "4_presets@1"
        },
        {
          "command": "extensionLoadout.applyPreset",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "4_presets@2"
        },
        {
          "command": "extensionLoadout.deletePreset",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer)",
          "group": "4_presets@3"
        }
      ],
      "view/item/context": [
        {
          "command": "extensionLoadout.enableHere",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem =~ /^ext:(off|global-off):switchable$/",
          "group": "inline@1"
        },
        {
          "command": "extensionLoadout.disableHere",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem =~ /^ext:(on|global-on|suggest|learned):switchable$/",
          "group": "inline@2"
        },
        {
          "command": "extensionLoadout.followGlobal",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem =~ /^ext:(on|off):/",
          "group": "inline@3"
        },
        {
          "command": "extensionLoadout.disableSuggested",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem == group:suggest",
          "group": "inline@1"
        },
        {
          "command": "extensionLoadout.measureMemory",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem == group:memory",
          "group": "inline@1"
        },
        {
          "command": "extensionLoadout.restartExtensionHost",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem == group:memory",
          "group": "inline@2"
        },
        {
          "command": "extensionLoadout.disableLearned",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem == group:learned",
          "group": "inline@1"
        },
        {
          "command": "extensionLoadout.installRecommended",
          "when": "(view == extensionLoadout.extensions || view == extensionLoadout.explorer) && viewItem == rec:missing",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "extensionLoadout.enableHere",
          "when": "false"
        },
        {
          "command": "extensionLoadout.disableHere",
          "when": "false"
        },
        {
          "command": "extensionLoadout.followGlobal",
          "when": "false"
        },
        {
          "command": "extensionLoadout.applyAndRestart",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.pick",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.suggest",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.disableSuggested",
          "when": "false"
        },
        {
          "command": "extensionLoadout.disableSelected",
          "when": "extensionLoadout.hasSelection"
        },
        {
          "command": "extensionLoadout.clearSelection",
          "when": "extensionLoadout.hasSelection"
        },
        {
          "command": "extensionLoadout.applyMenu",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.applyOnQuit",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.cancelApplyOnQuit",
          "when": "extensionLoadout.applyOnQuit"
        },
        {
          "command": "extensionLoadout.applyToOtherFolders",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.undo",
          "when": "extensionLoadout.canUndo"
        },
        {
          "command": "extensionLoadout.resetToGlobal",
          "when": "workbenchState != empty"
        },
        {
          "command": "extensionLoadout.measureMemory",
          "when": "false"
        },
        {
          "command": "extensionLoadout.disableLearned",
          "when": "false"
        },
        {
          "command": "extensionLoadout.installRecommended",
          "when": "false"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.vscode/extension-loadout.json",
          "*.loadout.json"
        ],
        "url": "./schemas/extension-loadout.schema.json"
      }
    ],
    "configuration": {
      "title": "Extension Loadout",
      "properties": {
        "extensionLoadout.memoryWatch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check the system memory pressure every minute while Extension Loadout is active, and show which extensions use memory in this window when it gets tight."
        },
        "extensionLoadout.memoryWatch.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification (once per session) when memory gets tight. The status bar indicator is shown either way."
        },
        "extensionLoadout.heavyThresholdMB": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "description": "Extensions whose processes use at least this many MB in this window are highlighted as heavy."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \"out/test/unit/*.test.js\"",
    "test:e2e": "npm run compile && node scripts/run-e2e.mjs",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "clean": "rm -rf dist out *.vsix",
    "test:e2e:open": "npm run compile && node scripts/run-e2e.mjs --open"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
